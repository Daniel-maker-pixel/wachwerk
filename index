<title>Wachwerk Wochenende Duderstadt</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500&family=Figtree:wght@400;500;600;700&display=swap">
<style>
/* Layout: dunkler Wald-Hero, dann ruhige Sektionen im Wechsel Warm White / Mint Lightest / Warm Gray; Inhalte in einer 1120px-Spalte */
:root{
  --forest-deep:#1a3d2b; --forest-mid:#2a6044; --forest-soft:#3d8a60; --sage:#5fa67a; --sage-light:#85c49e;
  --mint-pale:#e8f5ee; --mint-lightest:#f3fbf6; --amber:#c47a2a; --amber-pale:#fdf3e3;
  --warm-white:#fdfcfa; --warm-gray:#f4f2ee; --ink:#1f2a23; --ink-soft:#4d5b52; --line:#dfe6e0;
  --display:"Fraunces",Georgia,"Times New Roman",serif; --body:"Figtree",system-ui,-apple-system,sans-serif;
  color-scheme:light;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{margin:0;background:var(--warm-white);color:var(--ink);font-family:var(--body);font-size:16px;line-height:1.6}
.inner{max-width:1120px;margin:0 auto;padding-inline:20px}
section{padding-block:80px}
@media (max-width:640px){section{padding-block:56px}}
h1,h2,h3{font-family:var(--display);font-weight:400;line-height:1.12;margin:0;text-wrap:balance;color:var(--forest-deep)}
h2{font-size:clamp(30px,4.2vw,44px)}
h3{font-size:22px}
p{margin:0}
.eyebrow{font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--forest-soft);margin-bottom:14px}
.lead{font-size:18px;color:var(--ink-soft);max-width:62ch;margin-top:16px}
a{color:var(--forest-mid)}
.btn{display:inline-flex;align-items:center;gap:8px;font:600 15px var(--body);text-decoration:none;padding:13px 24px;border-radius:999px;border:1.5px solid transparent;transition:background .2s,color .2s,border-color .2s;cursor:pointer}
.btn-primary{background:var(--forest-mid);color:#fff}
.btn-primary:hover{background:var(--sage)}
.btn-ghost{border-color:var(--sage-light);color:var(--sage-light);background:transparent}
.btn-ghost:hover{background:var(--sage-light);color:var(--forest-deep)}
.btn:focus-visible,a:focus-visible,summary:focus-visible{outline:2px solid var(--amber);outline-offset:3px}

/* Nav */
nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:10;background:rgba(26,61,43,.94);backdrop-filter:blur(8px)}
nav .inner{display:flex;align-items:center;justify-content:space-between;gap:16px;height:64px}
.brand{font-family:var(--display);font-size:20px;color:#fff;text-decoration:none;white-space:nowrap}
.brand span{color:var(--sage-light)}
.navlinks{display:flex;gap:24px;align-items:center}
.navlinks a{color:#dfeee5;text-decoration:none;font-size:14px;font-weight:500}
.navlinks a:hover{color:var(--sage-light)}
.navlinks .btn{padding:9px 18px;font-size:14px;color:#fff}
@media (max-width:860px){.navlinks a:not(.btn){display:none}}

/* Hero */
.hero{background:var(--forest-deep);color:#fff;padding-block:84px 0;position:relative;overflow:hidden}
.hero-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:48px;align-items:end}
@media (max-width:860px){.hero-grid{grid-template-columns:minmax(0,1fr)}}
.hero .eyebrow{color:var(--sage-light)}
.hero h1{color:#fff;font-size:clamp(44px,7.4vw,86px);font-weight:300;letter-spacing:-.01em}
.hero h1 em{font-style:italic;color:var(--sage-light)}
.hero .claim{font-family:var(--display);font-size:clamp(20px,2.4vw,26px);color:#e4f1e9;margin-top:22px;max-width:30ch;font-weight:300}
.hero .actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:34px}
.facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:rgba(133,196,158,.25);border:1px solid rgba(133,196,158,.25);border-radius:16px;overflow:hidden}
.fact{background:var(--forest-deep);padding:18px 20px}
.fact b{display:block;font-family:var(--display);font-weight:400;font-size:28px;color:var(--sage-light);line-height:1.1}
.fact span{font-size:13px;color:#cfe3d7}
.ridge{display:block;width:100%;height:auto;margin-top:64px}

/* Thesis */
.thesis{background:var(--warm-white)}
.thesis blockquote{margin:0;font-family:var(--display);font-weight:300;font-size:clamp(26px,3.6vw,40px);line-height:1.25;color:var(--forest-deep);max-width:30ch}
.thesis blockquote em{color:var(--forest-soft)}
.thesis-grid{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:48px;align-items:start}
@media (max-width:860px){.thesis-grid{grid-template-columns:minmax(0,1fr)}}
.thesis p+p{margin-top:14px}
.thesis .copy{color:var(--ink-soft);font-size:17px}

/* Zugänge */
.paths{background:var(--mint-lightest)}
.path-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;margin-top:40px}
.path{background:var(--warm-white);border:1px solid var(--line);border-radius:14px;padding:22px;display:grid;gap:10px;align-content:start}
.path .icon{width:44px;height:44px;border-radius:12px;background:var(--mint-pale);display:grid;place-items:center}
.path .icon svg{width:24px;height:24px;stroke:var(--forest-mid);fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.path h3{font-size:21px}
.path p{font-size:15px;color:var(--ink-soft)}
.path .who{font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--forest-soft)}

/* Ablauf */
.days{background:var(--warm-white)}
.day-tabs{display:flex;gap:8px;margin-top:32px;flex-wrap:wrap}
.day-tabs button{font:600 14px var(--body);border:1.5px solid var(--forest-mid);background:transparent;color:var(--forest-mid);padding:9px 20px;border-radius:999px;cursor:pointer}
.day-tabs button[aria-selected="true"]{background:var(--forest-mid);color:#fff}
.day-tabs button:hover{border-color:var(--sage)}
.timeline{margin-top:26px;border-top:1px solid var(--line)}
.slot{display:grid;grid-template-columns:72px minmax(0,1fr) auto;gap:16px;padding:16px 0;border-bottom:1px solid var(--line);align-items:baseline}
.slot time{font-variant-numeric:tabular-nums;font-weight:600;color:var(--forest-soft)}
.slot h3{font-size:19px}
.slot p{font-size:14.5px;color:var(--ink-soft);margin-top:4px}
.slot .tag{font-size:12px;font-weight:600;background:var(--mint-pale);color:var(--forest-mid);padding:4px 10px;border-radius:999px;white-space:nowrap}
.slot.pause{padding:9px 0}
.slot.pause h3{font-family:var(--body);font-size:14px;font-weight:500;color:var(--ink-soft)}
@media (max-width:600px){.slot{grid-template-columns:56px minmax(0,1fr)}.slot .tag{grid-column:2;justify-self:start}}
.note{display:flex;gap:14px;background:var(--amber-pale);border:1px solid #f0dcb9;border-radius:14px;padding:18px 20px;margin-top:28px;color:#5a3a12}
.note b{color:var(--amber)}
.note svg{flex:none;width:22px;height:22px;stroke:var(--amber);fill:none;stroke-width:1.8;margin-top:2px}

/* Termine */
.dates{background:var(--warm-gray)}
.season-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-top:40px}
.season{background:var(--warm-white);border-radius:14px;padding:24px;border:1px solid var(--line);display:grid;gap:8px;align-content:start}
.season .s{font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--forest-soft)}
.season .d{font-family:var(--display);font-size:28px;color:var(--forest-deep);line-height:1.15}
.season p{font-size:14.5px;color:var(--ink-soft)}
.season.next{border-color:var(--forest-mid);box-shadow:0 0 0 1px var(--forest-mid)}
.chip{display:inline-block;font-size:12px;font-weight:600;background:var(--mint-pale);color:var(--forest-mid);padding:4px 10px;border-radius:999px;justify-self:start}

/* Tickets */
.tickets{background:var(--mint-lightest)}
.ticket-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;margin-top:40px;align-items:stretch}
.ticket{background:var(--warm-white);border:1px solid var(--line);border-radius:18px;padding:30px;display:flex;flex-direction:column;gap:18px}
.ticket.plus{background:var(--forest-deep);color:#e4f1e9;border-color:var(--forest-deep)}
.ticket.plus h3,.ticket.plus .price{color:#fff}
.ticket.plus li::before{background:var(--sage-light)}
.ticket.plus .muted{color:#b9d6c5}
.price{font-family:var(--display);font-size:52px;line-height:1;color:var(--forest-deep)}
.price small{font-family:var(--body);font-size:15px;color:var(--ink-soft);margin-left:6px}
.ticket.plus .price small{color:#b9d6c5}
.ticket ul{list-style:none;margin:0;padding:0;display:grid;gap:10px;font-size:15px}
.ticket li{position:relative;padding-left:22px}
.ticket li::before{content:"";position:absolute;left:0;top:.62em;width:8px;height:8px;border-radius:50%;background:var(--forest-soft)}
.ticket .btn{margin-top:auto;justify-content:center}
.ticket.plus .btn-primary{background:var(--sage-light);color:var(--forest-deep)}
.ticket.plus .btn-primary:hover{background:#fff}
.muted{font-size:13px;color:var(--ink-soft)}

/* Goodies */
.goodies{background:var(--warm-white)}
.goodie-cols{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px;margin-top:40px}
@media (max-width:820px){.goodie-cols{grid-template-columns:minmax(0,1fr)}}
.goodie-cols h3{font-size:20px;padding-bottom:10px;border-bottom:1px solid var(--line);margin-bottom:14px}
.goodie-cols ul{list-style:none;margin:0;padding:0;display:grid;gap:12px}
.goodie-cols li{display:grid;gap:2px}
.goodie-cols li b{font-weight:600;color:var(--forest-deep)}
.goodie-cols li span{font-size:14.5px;color:var(--ink-soft)}

/* Team */
.team{background:var(--warm-gray)}
.team-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;margin-top:40px}
.person{background:var(--warm-white);border-radius:14px;padding:26px;border:1px solid var(--line);display:grid;gap:10px;align-content:start}
.mono{width:56px;height:56px;border-radius:50%;background:var(--mint-pale);color:var(--forest-mid);display:grid;place-items:center;font-family:var(--display);font-size:24px}
.person .role{font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--forest-soft)}
.person p{font-size:15px;color:var(--ink-soft)}

/* Ort */
.place{background:var(--warm-white)}
.place-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:32px;margin-top:36px}
@media (max-width:820px){.place-grid{grid-template-columns:minmax(0,1fr)}}
.panel{background:var(--mint-lightest);border-radius:16px;padding:28px;display:grid;gap:12px;align-content:start}
.panel h3{font-size:22px}
.panel p{color:var(--ink-soft);font-size:15.5px}
.addr{font-weight:600;color:var(--forest-deep)}
.pack{display:flex;flex-wrap:wrap;gap:8px;margin-top:4px}
.pack span{background:var(--warm-white);border:1px solid var(--line);color:var(--forest-mid);font-size:13.5px;padding:6px 12px;border-radius:999px}

/* Gutschein */
.voucher{background:var(--forest-mid);color:#fff}
.voucher .inner{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:36px;align-items:center}
@media (max-width:820px){.voucher .inner{grid-template-columns:minmax(0,1fr)}}
.voucher h2{color:#fff}
.voucher .eyebrow{color:var(--sage-light)}
.voucher p{color:#dcefe3;margin-top:14px;max-width:52ch}
.vcard{border:1.5px dashed var(--sage-light);border-radius:16px;padding:26px;text-align:center;display:grid;gap:6px}
.vcard .v1{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--sage-light);font-weight:700}
.vcard .v2{font-family:var(--display);font-size:30px}
.vcard .v3{font-family:var(--display);font-size:44px;color:var(--sage-light);line-height:1}
.vcard .v4{font-size:13px;color:#cfe3d7}

/* FAQ */
.faq{background:var(--mint-lightest)}
.faq-list{margin-top:32px;max-width:820px;display:grid;gap:10px}
details{background:var(--warm-white);border:1px solid var(--line);border-radius:12px;padding:0 20px}
summary{cursor:pointer;list-style:none;padding:18px 0;font-weight:600;color:var(--forest-deep);display:flex;justify-content:space-between;gap:16px}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";font-family:var(--display);font-size:22px;color:var(--forest-soft);line-height:1}
details[open] summary::after{content:"–"}
details p{padding-bottom:18px;color:var(--ink-soft);font-size:15.5px}

/* Footer */
footer{background:var(--forest-deep);color:#cfe3d7;padding-block:56px 40px;font-size:14.5px}
.foot-grid{display:grid;grid-template-columns:minmax(0,1.4fr) repeat(2,minmax(0,1fr));gap:32px}
@media (max-width:760px){.foot-grid{grid-template-columns:minmax(0,1fr)}}
footer .brand{font-size:24px}
footer h4{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--sage-light);margin:0 0 10px}
footer p+p{margin-top:6px}
.legal{border-top:1px solid rgba(133,196,158,.25);margin-top:36px;padding-top:20px;font-size:12.5px;color:#a8c7b5}
</style>

<nav aria-label="Hauptnavigation">
  <div class="inner">
    <a class="brand" href="#top">Wachwerk <span>Wochenende</span></a>
    <div class="navlinks">
      <a href="#zugaenge">Zugänge</a>
      <a href="#ablauf">Ablauf</a>
      <a href="#termine">Termine</a>
      <a href="#team">Team</a>
      <a href="#faq">Fragen</a>
      <a class="btn btn-primary" href="#tickets">Platz sichern</a>
    </div>
  </div>
</nav>

<header class="hero" id="top">
  <div class="inner hero-grid">
    <div>
      <div class="eyebrow">Duderstadt · am Euzenberg · vier Mal im Jahr</div>
      <h1>Wachwerk<br><em>Wochenende</em></h1>
      <p class="claim">Zwei Tage für Bewusstsein, Achtsamkeit und das Bei-sich-Sein.</p>
      <div class="actions">
        <a class="btn btn-primary" href="#tickets">Platz sichern</a>
        <a class="btn btn-ghost" href="#ablauf">Ablauf ansehen</a>
      </div>
    </div>
    <div class="facts" aria-label="Eckdaten">
      <div class="fact"><b>15</b><span>Plätze pro Wochenende</span></div>
      <div class="fact"><b>2 Tage</b><span>Sa 10–18 · So 10–16 Uhr</span></div>
      <div class="fact"><b>5</b><span>Zugänge, 3 Begleiter</span></div>
      <div class="fact"><b>ab 220 €</b><span>inkl. Mittagessen &amp; Goodies</span></div>
    </div>
  </div>
  <svg class="ridge" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 120 L0 78 C180 70 300 52 470 58 C620 63 700 34 820 30 C900 27 940 12 990 10 L996 0 L1002 10 C1080 14 1180 46 1300 56 C1370 62 1410 66 1440 66 L1440 120 Z" fill="#2a6044" opacity=".55"/>
    <path d="M0 120 L0 96 C240 86 420 76 640 82 C860 88 1060 70 1240 76 C1340 79 1400 84 1440 86 L1440 120 Z" fill="#fdfcfa"/>
  </svg>
</header>

<section class="thesis">
  <div class="inner thesis-grid">
    <blockquote>Kein Retreat zum Abschalten, sondern ein Wochenende zum <em>Einschalten</em>.</blockquote>
    <div class="copy">
      <p>Die meiste Zeit unseres Tages läuft auf Autopilot. Bewusstsein heißt hier nicht, etwas Besonderes zu erreichen, sondern wieder mitzubekommen, was gerade geschieht: im Körper, im Kopf, im Klang des Raums.</p>
      <p>In Einheiten von höchstens einer Stunde, mit Pausen zum Nachspüren, öffnest du deine Wahrnehmung. Ohne Vorkenntnisse, ohne Leistungsdruck, ohne Dogma. Und in einer Gruppe von 15 Menschen, in der du ganz bei dir sein darfst und trotzdem verbunden bist.</p>
    </div>
  </div>
</section>

<section class="paths" id="zugaenge">
  <div class="inner">
    <div class="eyebrow">Fünf Zugänge</div>
    <h2>Ein Bewusstsein, viele Wege dorthin</h2>
    <p class="lead">Du musst vorher nicht wissen, welche Methode zu dir passt. An diesem Wochenende probierst du alle aus und spürst, welcher Weg trägt.</p>
    <div class="path-grid">
      <article class="path">
        <div class="icon"><svg viewBox="0 0 24 24"><path d="M12 22V12"/><path d="M12 12c-4 0-7-3-7-7 4 0 7 3 7 7z"/><path d="M12 15c3.5 0 6-2.5 6-6-3.5 0-6 2.5-6 6z"/></svg></div>
        <div class="who">Bea</div>
        <h3>Natur</h3>
        <p>Bäume umarmen, Aufstieg in Stille am Euzenberg, Weitblick bis zum Seeburger See.</p>
      </article>
      <article class="path">
        <div class="icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="5" r="2"/><path d="M12 7v6"/><path d="M6 10l6 3 6-3"/><path d="M9 21l3-8 3 8"/></svg></div>
        <div class="who">Bea</div>
        <h3>Körper</h3>
        <p>Ruhiges Yoga im Atemrhythmus, mit Varianten für jede Beweglichkeit.</p>
      </article>
      <article class="path">
        <div class="icon"><svg viewBox="0 0 24 24"><path d="M12 3a6 6 0 0 0-6 6c0 2.5 1.5 4 2.5 5v3h7v-3c1-1 2.5-2.5 2.5-5a6 6 0 0 0-6-6z"/><path d="M9.5 21h5"/></svg></div>
        <div class="who">Adrian</div>
        <h3>Geist</h3>
        <p>Verstehen, wie der Autopilot entsteht. Trance erleben und Selbsthypnose für den Alltag lernen.</p>
      </article>
      <article class="path">
        <div class="icon"><svg viewBox="0 0 24 24"><path d="M4 10v4"/><path d="M8 7v10"/><path d="M12 4v16"/><path d="M16 7v10"/><path d="M20 10v4"/></svg></div>
        <div class="who">Carinha</div>
        <h3>Stimme</h3>
        <p>Den eigenen Ton entdecken und im Hall des Treppenhauses gemeinsam singen.</p>
      </article>
      <article class="path">
        <div class="icon"><svg viewBox="0 0 24 24"><ellipse cx="12" cy="15" rx="8" ry="3"/><path d="M4 15c0-4 3.6-7 8-7s8 3 8 7"/><path d="M12 4v2"/></svg></div>
        <div class="who">Carinha · Bea · Adrian</div>
        <h3>Klang</h3>
        <p>Musikalische SoundJourney und ein Konzert mit Kristallklangschalen als stiller Schlusspunkt.</p>
      </article>
    </div>
  </div>
</section>

<section class="days" id="ablauf">
  <div class="inner">
    <div class="eyebrow">Ablauf</div>
    <h2>Gebaut nach der Tageszeit</h2>
    <p class="lead">Wache Sinne am Vormittag, Bewegung durch das Mittagstief, Ruhe gegen Abend. Jede Einheit dauert höchstens 60 Minuten.</p>
    <div class="day-tabs" role="tablist" aria-label="Tag wählen">
      <button id="tab-sa" role="tab" aria-selected="true" aria-controls="day-sa">Samstag · 10–18 Uhr</button>
      <button id="tab-so" role="tab" aria-selected="false" aria-controls="day-so">Sonntag · 10–16 Uhr</button>
    </div>
    <div class="timeline" id="day-sa" role="tabpanel" aria-labelledby="tab-sa">
      <div class="slot"><time>10:00</time><div><h3>Ankommen</h3><p>Eröffnungsklang, kurze Orientierung, deine Absicht für das Wochenende, still notiert.</p></div><span class="tag">gemeinsam</span></div>
      <div class="slot"><time>10:30</time><div><h3>Natur oder Stimme</h3><p>Die Gruppe teilt sich: Bäume umarmen am Euzenberg oder den eigenen Ton entdecken. Nach dem Mittagessen wird getauscht.</p></div><span class="tag">Bea · Carinha</span></div>
      <div class="slot"><time>11:45</time><div><h3>Bewusstsein und Autopilot</h3><p>Warum wir automatisch reagieren und wie sich das ändern lässt. Mit Gruppentrance.</p></div><span class="tag">Adrian</span></div>
      <div class="slot"><time>12:55</time><div><h3>Achtsames Mittagessen</h3><p>Der erste Bissen in Stille, dann Essen im Gespräch.</p></div><span class="tag">Carinha</span></div>
      <div class="slot"><time>14:05</time><div><h3>Natur oder Stimme, getauscht</h3><p>Jeder erlebt beides. Aktiv durch das Mittagstief.</p></div><span class="tag">Bea · Carinha</span></div>
      <div class="slot"><time>15:20</time><div><h3>Selbsthypnose</h3><p>Bewusst umschalten statt automatisch reagieren. Dein Werkzeug für den Alltag.</p></div><span class="tag">Adrian</span></div>
      <div class="slot"><time>16:40</time><div><h3>SoundJourney</h3><p>Musikalische Reise im Liegen: Erzählung, Live-Instrumente, Klangflächen.</p></div><span class="tag">Bea · Adrian</span></div>
      <div class="slot"><time>17:40</time><div><h3>Tagesausklang</h3><p>Sanftes Dehnen und Schlussklang.</p></div><span class="tag">gemeinsam</span></div>
    </div>
